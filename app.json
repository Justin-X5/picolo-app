{
  "expo": {
    "name": "picolo",
    "slug": "picolo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "picolo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.justin.picolo"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d2be057f-762b-443f-b520-223bb44b0df7"
      }
    },
    "owner": "copied"
  }
}
